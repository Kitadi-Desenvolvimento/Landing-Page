# Blue Lemon API endpoint.
BLUELEMON_API_BASE_URL=https://api.bluelemon.ao/v1

# Set both values locally in .env.local. Never commit or share real secrets.
BLUELEMON_API_KEY_SECRET=
BLUELEMON_WEBHOOK_SECRET=

# Register this route in the Blue Lemon dashboard using a public HTTPS URL.
# In local testing, expose the dev server through an HTTPS tunnel.
# Test payments are held in Next.js process memory; restarting Next clears them.
# Payment routes intentionally return 503 in production until durable storage is added.
