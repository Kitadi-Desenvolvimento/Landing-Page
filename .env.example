# Public site origin. On Vercel, set this per environment:
# Production: https://www.kitadi.co.ao
# Development: https://development.kitadi.co.ao
NEXT_PUBLIC_SITE_URL=https://www.kitadi.co.ao

# Public Supabase project configuration. Data access must be protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Used only by the one-time initial administrator invitation script.
BACKOFFICE_ADMIN_EMAIL=operacoes@kitadi.co.ao
# In Supabase Auth URL Configuration, set the site URL to NEXT_PUBLIC_SITE_URL
# and allow https://<your-domain>/auth/callback as a redirect URL.
# Configure Supabase Auth email delivery (SMTP) before sending invitations.

# WiPay hosted checkout. Set the secrets only in .env.local.
WIPAY_BASE_URL=https://api.wipay.ao
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=

# Public HTTPS address that WiPay calls after a payment.
# Production: https://www.kitadi.co.ao/api/webhooks/wipay
# Development: https://development.kitadi.co.ao/api/webhooks/wipay
WIPAY_CALLBACK_URL=https://www.kitadi.co.ao/api/webhooks/wipay
