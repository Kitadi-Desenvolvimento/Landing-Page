# Public site origin. On Vercel, set this per environment:
# Production: https://www.kitadi.co.ao
# Development: https://development.kitadi.co.ao
NEXT_PUBLIC_SITE_URL=https://www.kitadi.co.ao

# WiPay hosted checkout. Set the secrets only in .env.local.
WIPAY_BASE_URL=https://api.wipay.ao
WIPAY_CLIENT_ID=
WIPAY_CLIENT_SECRET=

# Public HTTPS address that WiPay calls after a payment.
# Production: https://www.kitadi.co.ao/api/webhooks/wipay
# Development: https://development.kitadi.co.ao/api/webhooks/wipay
WIPAY_CALLBACK_URL=https://www.kitadi.co.ao/api/webhooks/wipay
