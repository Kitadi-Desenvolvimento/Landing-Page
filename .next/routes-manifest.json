{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/backoffice/products/[slug]",
      "regex": "^/api/backoffice/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/api/backoffice/products/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/payments/charges/[paymentId]",
      "regex": "^/api/payments/charges/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpaymentId": "nxtPpaymentId"
      },
      "namedRegex": "^/api/payments/charges/(?<nxtPpaymentId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/payments/orders/[reference]",
      "regex": "^/api/payments/orders/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPreference": "nxtPreference"
      },
      "namedRegex": "^/api/payments/orders/(?<nxtPreference>[^/]+?)(?:/)?$"
    },
    {
      "page": "/formacoes/[slug]/inscricao",
      "regex": "^/formacoes/([^/]+?)/inscricao(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/formacoes/(?<nxtPslug>[^/]+?)/inscricao(?:/)?$"
    },
    {
      "page": "/produtos/[slug]",
      "regex": "^/produtos/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/produtos/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/auth/callback",
      "regex": "^/auth/callback(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/auth/callback(?:/)?$"
    },
    {
      "page": "/backoffice",
      "regex": "^/backoffice(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/backoffice(?:/)?$"
    },
    {
      "page": "/backoffice/acesso-negado",
      "regex": "^/backoffice/acesso\\-negado(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/backoffice/acesso\\-negado(?:/)?$"
    },
    {
      "page": "/backoffice/definir-senha",
      "regex": "^/backoffice/definir\\-senha(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/backoffice/definir\\-senha(?:/)?$"
    },
    {
      "page": "/backoffice/login",
      "regex": "^/backoffice/login(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/backoffice/login(?:/)?$"
    },
    {
      "page": "/checkout/retorno",
      "regex": "^/checkout/retorno(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/checkout/retorno(?:/)?$"
    },
    {
      "page": "/formacoes",
      "regex": "^/formacoes(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/formacoes(?:/)?$"
    },
    {
      "page": "/produtos",
      "regex": "^/produtos(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/produtos(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}